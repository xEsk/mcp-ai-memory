MEMORY_DB_PATH=/absolute/path/to/memory.db
MEMORY_ENRICHER=heuristic
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=gpt-4.1-mini
MEMORY_EMBEDDINGS_ENABLED=false
MEMORY_EMBEDDING_BASE_URL=http://localhost:11434
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_TRACE_MODE=off
MEMORY_TRACE_MONITOR_URL=http://127.0.0.1:7379/events
MEMORY_TRACE_BUFFER_SIZE=256
MEMORY_TRACE_DEBUG=false
